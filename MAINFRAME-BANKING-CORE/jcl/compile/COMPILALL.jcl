  //COMPILALL JOB (BANK),'COMPILE ALL COBOL PROGRAMS',
  //          CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1),
  //          NOTIFY=&SYSUID
  //*
  //*================================================================*
  //* JOB: COMPILALL                                                  *
  //* PURPOSE: COMPILE ALL BANKING PROGRAMS IN DEPENDENCY ORDER       *
  //* USES: OS/VS COBOL COMPILER (IGYCRCTL) VIA TK4-                  *
  //*       ADJUST SYS1.COBOL AND SYS1.COPYLIB TO YOUR PDS NAMES     *
  //*================================================================*
  //*
  //*--- COMPILE DATEVAL (utility, no VSAM deps) ----------------
  //COMP01   EXEC PGM=IGYCRCTL,REGION=512K,
  //         PARM='NOSSRANGE,NOSEQUENCE,NODECK,OBJECT,XREF'
  //STEPLIB  DD DSN=SYS1.COBLIB,DISP=SHR
  //SYSPRINT DD SYSOUT=*
  //SYSIN    DD DSN=SYS1.COBOL(DATEVAL),DISP=SHR
  //SYSLIB   DD DSN=SYS1.COPYLIB,DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSLIN   DD DSN=&&DATEVAL,DISP=(NEW,PASS),
  //         UNIT=SYSDA,SPACE=(TRK,(10,5))
  //*
  //*--- LINK DATEVAL -------------------------------------------
  //LKED01   EXEC PGM=IEWL,REGION=512K,COND=(5,LT,COMP01),
  //         PARM='LIST,XREF,LET'
  //SYSPRINT DD SYSOUT=*
  //SYSLIN   DD DSN=&&DATEVAL,DISP=(OLD,DELETE)
  //SYSLMOD  DD DSN=SYS1.BANKLOAD(DATEVAL),DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //*
  //*--- COMPILE ERRHANDL ---------------------------------------
  //COMP02   EXEC PGM=IGYCRCTL,REGION=512K,
  //         PARM='NOSSRANGE,NOSEQUENCE,NODECK,OBJECT,XREF'
  //STEPLIB  DD DSN=SYS1.COBLIB,DISP=SHR
  //SYSPRINT DD SYSOUT=*
  //SYSIN    DD DSN=SYS1.COBOL(ERRHANDL),DISP=SHR
  //SYSLIB   DD DSN=SYS1.COPYLIB,DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSLIN   DD DSN=&&ERRHANDL,DISP=(NEW,PASS),
  //         UNIT=SYSDA,SPACE=(TRK,(10,5))
  //*
  //LKED02   EXEC PGM=IEWL,REGION=512K,COND=(5,LT,COMP02),
  //         PARM='LIST,XREF,LET'
  //SYSPRINT DD SYSOUT=*
  //SYSLIN   DD DSN=&&ERRHANDL,DISP=(OLD,DELETE)
  //SYSLMOD  DD DSN=SYS1.BANKLOAD(ERRHANDL),DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //*
  //*--- COMPILE CUSTMGMT ---------------------------------------
  //COMP03   EXEC PGM=IGYCRCTL,REGION=512K,
  //         PARM='NOSSRANGE,NOSEQUENCE,NODECK,OBJECT,XREF'
  //STEPLIB  DD DSN=SYS1.COBLIB,DISP=SHR
  //SYSPRINT DD SYSOUT=*
  //SYSIN    DD DSN=SYS1.COBOL(CUSTMGMT),DISP=SHR
  //SYSLIB   DD DSN=SYS1.COPYLIB,DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSLIN   DD DSN=&&CUSTMGMT,DISP=(NEW,PASS),
  //         UNIT=SYSDA,SPACE=(TRK,(10,5))
  //LKED03   EXEC PGM=IEWL,REGION=512K,COND=(5,LT,COMP03),
  //         PARM='LIST,XREF,LET'
  //SYSPRINT DD SYSOUT=*
  //SYSLIN   DD DSN=&&CUSTMGMT,DISP=(OLD,DELETE)
  //         DD DSN=SYS1.BANKLOAD(DATEVAL),DISP=SHR
  //         DD DSN=SYS1.BANKLOAD(ERRHANDL),DISP=SHR
  //SYSLMOD  DD DSN=SYS1.BANKLOAD(CUSTMGMT),DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //*
  //*--- COMPILE ACCTMGMT ---------------------------------------
  //COMP04   EXEC PGM=IGYCRCTL,REGION=512K,
  //         PARM='NOSSRANGE,NOSEQUENCE,NODECK,OBJECT,XREF'
  //STEPLIB  DD DSN=SYS1.COBLIB,DISP=SHR
  //SYSPRINT DD SYSOUT=*
  //SYSIN    DD DSN=SYS1.COBOL(ACCTMGMT),DISP=SHR
