  //SYSPRINT DD SYSOUT=*
  //SYSLIN   DD DSN=&&ACCTMGMT,DISP=(OLD,DELETE)
  //         DD DSN=SYS1.BANKLOAD(DATEVAL),DISP=SHR
  //         DD DSN=SYS1.BANKLOAD(ERRHANDL),DISP=SHR
  //SYSLMOD  DD DSN=SYS1.BANKLOAD(ACCTMGMT),DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //*
  //*--- COMPILE BATCHPROC + RPTGEN -------------------------------
  //COMP10   EXEC PGM=IGYCRCTL,REGION=512K,
  //         PARM='NOSSRANGE,NOSEQUENCE,NODECK,OBJECT,XREF'
  //STEPLIB  DD DSN=SYS1.COBLIB,DISP=SHR
  //SYSPRINT DD SYSOUT=*
  //SYSIN    DD DSN=SYS1.COBOL(BATCHPROC),DISP=SHR
  //SYSLIB   DD DSN=SYS1.COPYLIB,DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
  //SYSLIN   DD DSN=&&BATCHPROC,DISP=(NEW,PASS),
  //         UNIT=SYSDA,SPACE=(TRK,(20,5))
  //LKED10   EXEC PGM=IEWL,REGION=512K,COND=(5,LT,COMP10),
  //         PARM='LIST,XREF,LET'
  //SYSPRINT DD SYSOUT=*
  //SYSLIN   DD DSN=&&BATCHPROC,DISP=(OLD,DELETE)
  //         DD DSN=SYS1.BANKLOAD(DATEVAL),DISP=SHR
  //         DD DSN=SYS1.BANKLOAD(ERRHANDL),DISP=SHR
  //SYSLMOD  DD DSN=SYS1.BANKLOAD(BATCHPROC),DISP=SHR
  //SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
