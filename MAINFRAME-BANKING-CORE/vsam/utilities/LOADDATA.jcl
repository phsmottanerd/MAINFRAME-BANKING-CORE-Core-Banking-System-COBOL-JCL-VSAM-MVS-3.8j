  //LOADDATA  JOB (BANK),'LOAD SEED DATA INTO VSAM',
  //          CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1)
  //*
  //*================================================================*
  //* JOB: LOADDATA                                                   *
  //* PURPOSE: REPRO SEED DATA FROM FLAT FILES INTO VSAM CLUSTERS     *
  //* PREREQUISITES: DEFVSAM MUST HAVE BEEN RUN FIRST                 *
  //* SEED FILES MUST BE UPLOADED TO TK4- BEFORE SUBMITTING THIS JOB  *
  //*================================================================*
  //STEP1    EXEC PGM=IDCAMS
  //SYSPRINT DD SYSOUT=*
  //CUSTFLAT DD DSN=BANK.SEED.CUSTOMERS,DISP=SHR
  //CUSTMST  DD DSN=BANK.CUSTOMER.MASTER,DISP=SHR
  //ACCTFLAT DD DSN=BANK.SEED.ACCOUNTS,DISP=SHR
  //ACCTMST  DD DSN=BANK.ACCOUNT.MASTER,DISP=SHR
  //SYSIN    DD *
    REPRO INFILE(CUSTFLAT) OUTFILE(CUSTMST)
    REPRO INFILE(ACCTFLAT) OUTFILE(ACCTMST)
  /*
